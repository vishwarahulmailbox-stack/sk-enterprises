        <div mbr-text=\"\" class=\"user_name mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\"><b>Turnkey Projects</b></div>\n                            <div mbr-text=\"\" class=\"user_desk mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Guru</div>\n                        </div>\n                    </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"user\">\n                            <div class=\"user_image\">\n                                <div class=\"item-wrapper position-relative\">\n                                    \n                                <a href=\"patil.html#gallery01-2d\" target=\"false\"></a><a href=\"4bhk1800.html#gallery01-2p\" target=\"true\"></a><a href=\"4bhk1800.html#gallery01-2p\" target=\"true\"></a><a href=\"2bhk1200.html#gallery01-1u\" target=\"true\"></a><a href=\"page5.html\" target=\"true\"></a><a href=\"5bhk3000.html\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/20250619-122621-815x611.jpg\" alt=\"5 BHK\" data-slide-to=\"3\" data-bs-slide-to=\"3\"></a></div>\n                            </div>\n                            <div class=\"user_text mb-4\">\n                                <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".user_text\"><b>Penthouse, 3000 sq ft</b></p>\n                            </div>\n                            <div mbr-text=\"\" class=\"user_name mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\"><b>Turnkey Projects</b></div>\n                            <div mbr-text=\"\" class=\"user_desk mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Guru</div>\n                        </div>\n                    </div><div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"user\">\n                            <div class=\"user_image\">\n                                <div class=\"item-wrapper position-relative\">\n                                    \n                                <a href=\"patil.html#gallery01-2d\" target=\"false\"></a><a href=\"4bhk1800.html#gallery01-2p\" target=\"true\"></a><a href=\"4bhk1800.html#gallery01-2p\" target=\"true\"></a><a href=\"2bhk1200.html#gallery01-1u\" target=\"true\"></a><a href=\"page6.html\" target=\"true\"><a href=\"lobby.html\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/whatsapp%2520image%25202025-08-15%2520at%25204.30.57%2520pm%2520(2)-815x611.jpg\" alt=\"Lobby \" data-slide-to=\"4\" data-bs-slide-to=\"4\"></a></a></div>\n                            </div>\n                            <div class=\"user_text mb-4\">\n                                <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".user_text\"><b>Reception Lobby</b></p>\n                            </div>\n                            <div mbr-text=\"\" class=\"user_name mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\"><b>Turnkey Projects</b></div>\n                            <div mbr-text=\"\" class=\"user_desk mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Guru</div>\n                        </div>\n                    </div>\n                    \n                </div>\n            </div>\n            <button class=\"embla__button embla__button--prev\">\n                <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n            </button>\n            <button class=\"embla__button embla__button--next\">\n                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n            </button>\n        </div>\n    </div>\n</section>",
          "_anchor": "slider02-26",
          "_isUserblock": true,
